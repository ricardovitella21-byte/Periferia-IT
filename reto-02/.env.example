# Copia este archivo a .env y completa los valores. .env nunca se sube al repositorio.

# Clave del modelo (solo backend). Obligatoria con LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# anthropic = Claude · guion = proveedor de prueba sin IA (no necesita clave)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_MS=90000
# default = si el modelo declina por política, el servidor reintenta en otro modelo · off = desactivado
LLM_FALLBACK=default

# Control de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
MAX_TOKENS_DIA=5000000

# Servidor
PORT=3000
# Opcional: si se define, la API exige el encabezado x-clave-acceso (el chat la pide una vez).
ACCESS_KEY=

# Opcional: fecha fija (YYYY-MM-DD) para evaluar vigencias de soportes. Vacío = fecha de ejecución.
FECHA_REFERENCIA=
# Zona horaria para "hoy" (por defecto America/Bogota).
ZONA_HORARIA=America/Bogota
